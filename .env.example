# OpenWeather API for live rainfall forecasts (free tier works)
OPENWEATHER_API_KEY=your_openweather_key_here

# Groq API for AI chatbot (free tier works)  
GROQ_API_KEY=your_groq_key_here

# KVdb bucket ID for persistent leaderboard (optional, free)
KVDB_BUCKET_ID=jalnet_leaderboard_v1

# Base installation cost rate in INR per sqm
COST_RATE=120
